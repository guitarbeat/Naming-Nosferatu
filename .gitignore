Desktop.ini
*~

# Accidental local copy artifacts (for example: "file 2.ts")
* 2.*
* 3.*

# Large media files (prevent accidental commits)
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.aac
# Allow small sound effects (under 1MB) - adjust threshold as needed
!public/assets/sounds/
!public/assets/sounds/*.mp3
!public/assets/sounds/*.wav
!public/assets/sounds/*.ogg

# Large image files (prevent uncompressed originals)
*.psd
*.ai
*.tiff
*.tif
*.bmp
# Allow optimized web formats
!*.{jpg,jpeg,png,gif,webp,avif,svg}

# Large video files
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
.smart-coding-cache/

# Avoid case-collision with tracked .Jules directory
.jules/
!.Jules/
!.Jules/**

# Supabase & External tool artifacts
supabase/.temp/
supabase/.branches/
.dyad/
.agents/skills/ui-ux-pro-max/scripts/__pycache__/
*.sh
